{
  "name": "council-of-iron",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A diplomacy-first real-time strategy game for humans and agents.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "python tests/browser.py",
    "cli": "node agents/cli.js",
    "mcp": "node agents/mcp.js",
    "bot": "node agents/bot.js",
    "check": "node scripts/check.js",
    "test:balance": "node scripts/tournament.js",
    "test:review": "python tests/review-browser.py"
  },
  "devDependencies": {
    "tone": "^15.1.22"
  }
}
