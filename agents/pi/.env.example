# Copy these generic values into the ignored root .env and replace them.
PI_DEFAULT_MODEL=sample
PI_MODEL_SAMPLE_PROVIDER=openai-completions
PI_MODEL_SAMPLE_BASE_URL=http://127.0.0.1:8000/v1
PI_MODEL_SAMPLE_ID=your-model-id
PI_MODEL_SAMPLE_NAME="Your local model"
PI_MODEL_SAMPLE_PLAYER_NAME="Your model Pi"
PI_MODEL_SAMPLE_LEADER_NAME="The Visiting Regent"
PI_MODEL_SAMPLE_CONTEXT_WINDOW=262144
PI_MODEL_SAMPLE_MAX_TOKENS=4096
PI_MODEL_SAMPLE_TRANSPORT=chat_completions
PI_MODEL_SAMPLE_THINKING_LEVEL=off
